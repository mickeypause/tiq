{
  "name": "rn-qa-overlay-workspace",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "prepare": "bun run build",
    "build": "bun run --filter @mickeypause/tiq build",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example",
    "test": "bun test",
    "check": "bun run build && bun run lint && bun run typecheck && bun test",
    "verify:exclusion": "bun run build && bun scripts/verify-exclusion.ts",
    "start": "bun run --cwd example start",
    "ios": "bun run build && bun run --cwd example ios",
    "android": "bun run build && bun run --cwd example android",
    "test:linear:ios": "bash scripts/test-linear-ios.sh",
    "test:linear:android": "cd example/android && ./gradlew :mickeypause-tiq:testDebugUnitTest --console=plain",
    "pack": "bun scripts/pack.ts",
    "verify:package": "bun scripts/verify-package.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "latest",
    "typescript": "~6.0.3"
  }
}
