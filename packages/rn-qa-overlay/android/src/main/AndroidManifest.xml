<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <application>
    <activity android:name=".QaOverlayActivity" android:exported="false" android:theme="@style/QaOverlayActivityTheme" android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
    <service android:name=".QaRecordingService" android:exported="false" android:foregroundServiceType="mediaProjection" />
    <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.qaoverlay.files" android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/qa_overlay_paths" />
    </provider>
  </application>
</manifest>
